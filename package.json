{
  "name": "bible-verse-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:bible": "node scripts/build-bible.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --experimental-strip-types scripts/verify.ts",
    "test:ui": "node --experimental-strip-types scripts/verify-ui.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy": "vercel deploy --prod",
    "setup": "npm install && npm run build:bible"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chrome-remote-interface": "^0.34.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
